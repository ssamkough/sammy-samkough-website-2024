---
import PageLayout from "../layouts/PageLayout.astro";
import { TITLES } from "../utils/constants";
---

<PageLayout title={TITLES.about}>
  <p>
    I'm Sammy Samkough, a <a href="/circassian">Circassian</a> Syrian American, born
    in New Jersey.
  </p>

  <p>AND I JUST GOT MARRIED! OH YES! ♥</p>

  <figure>
    <img
      src="/abouts/portraits-003.JPG"
      alt="Posing with my wife on our wedding day"
      height="300"
      height="190"
    />
    <figcaption>
      <p>Our favorite picture</p>
      <p>
        You can view more pictures here: <a href="https://ts2026.wedding"
          >ts2026.wedding</a>
      </p>
    </figcaption>
  </figure>

  <br />
  <time datetime="2026-09-22">Last updated: 2026-09-22 </time>

  <br />
  <br />
</PageLayout>

<style>
  p {
    line-height: 1.8em;
  }
</style>
