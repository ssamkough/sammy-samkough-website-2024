---
import PageLayout from "../layouts/PageLayout.astro";
import { TITLES } from "../utils/constants";
---

<PageLayout title={TITLES.cooks}>
  <figure>
    <img
      src="/cooks/2026-09-14.jpeg"
      alt="Fish with asparagus and potatoes"
      width="300"
      height="400"
    />
    <figcaption>Fish with asparagus and potatoes</figcaption>
  </figure>
  <figure>
    <img
      src="/cooks/2026-09-15.jpeg"
      alt="Marinated chicken with salad and mashed potatoes"
      width="300"
      height="400"
    />
    <figcaption>Marinated chicken with salad and mashed potatoes</figcaption>
  </figure>
</PageLayout>
