---
import FullLayout from "../layouts/FullLayout.astro";
import { TITLES } from "../utils/constants";
---

<FullLayout title={TITLES.cooks}>
  <div>
    <figure>
      <img
        src="/cooks/2026-09-20.jpeg"
        alt="Chipotle shrimp tacos with curry rice with beans"
        width="300"
        height="400"
      />
      <figcaption>Chipotle shrimp tacos with curry rice with beans</figcaption>
      <date>2026-09-20</date>
    </figure>
    <figure>
      <img
        src="/cooks/2026-09-19.jpeg"
        alt="Marinated chicken with ready-made salad"
        width="300"
        height="400"
      />
      <figcaption>
        Marinated chicken w/ basmati rice and ready-made salad
      </figcaption>
      <date>2026-09-19</date>
    </figure>
    <figure>
      <img
        src="/cooks/2026-09-15.jpeg"
        alt="Marinated chicken with salad and mashed potatoes"
        width="300"
        height="400"
      />
      <figcaption>Marinated chicken with salad and mashed potatoes</figcaption>
      <date>2026-09-15</date>
    </figure>
    <figure>
      <img
        src="/cooks/2026-09-14.jpeg"
        alt="Fish with asparagus and potatoes"
        width="300"
        height="400"
      />
      <figcaption>Salmon fish with asparagus and flavorful potatoes</figcaption>
      <date>2026-09-14</date>
    </figure>
  </div>
</FullLayout>

<style>
  div {
    margin-top: 0.4em;
    display: grid;
    grid-template-columns: repeat(auto-fill, 300px);
    row-gap: 2em;
    column-gap: 2em;
  }
  figure {
    border: 4px dotted saddlebrown;
    padding: 0.8em;
  }
  date {
    font-style: italic;
  }
</style>
