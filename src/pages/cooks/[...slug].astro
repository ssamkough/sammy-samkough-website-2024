---
import { getCollection } from "astro:content";
import CookLayout from "../../layouts/CookLayout.astro";

export async function getStaticPaths() {
  const cookEntries = await getCollection("cooks");
  return cookEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<CookLayout frontmatter={entry.data}>
  <Content />
</CookLayout>
