    {
      ACTIVE_ITEMS.map(({ title, href }) => (
        <li>{href ? <a href={href}>{title}</a> : <span>{title}</span>}</li>
      ))
    }
  </ul>

  <br />

  <p>Archived projects:</p>
  <ul>
    {
      ARCHIVED_ITEMS.map(({ title, href }) => (
        <li>{href ? <a href={href}>{title}</a> : <span>{title}</span>}</li>
      ))
    }
  </ul>

  <br />

  <p>Other:</p>
  <ul>
    {
      OTHER_ITEMS.map(({ title, href }) => (
        <li>{href ? <a href={href}>{title}</a> : <span>{title}</span>}</li>
      ))
    }
  </ul>
</PageLayout>
