---
import BonnySystems from "../components/BonnySystems.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { TITLES } from "../utils/constants";
---

<PageLayout title={TITLES.works}>
  <section>
    <ul>
      <li>
        Working at Holly as a Senior Engineer <img
          src="/works/holly-logo-dark.svg"
          alt="Holly logo"
          width="80px"
          style="background: black;"
        />
      </li>
      <li>
        Onboarding to family business <a
          href="https://unitedcleaningcorp.com"
          class="united-cleaning-text"
        >
          United Cleaning
        </a>
      </li>
      <li>
        Personal consulting shop at <BonnySystems />
      </li>
    </ul>
  </section>

  <br />

  <section>
    <p>
      Resume: <a href="https://cv.sammy.pizza">cv.sammy.pizza</a>
    </p>
    <p>
      Begrudginly my linkedin: <em
        ><s>
          <a href=""> https://www.linkedin.com/in/ssamkough </a>
        </s>
      </em>
    </p>
  </section>

  <section>
    <p>
      Between September 2026 - November 2026, I was in a deep job search. I
      captured my journey here:{" "}
      <a href="https://jbg.sammy.pizza">🥊 Job Game 2026</a>
    </p>
  </section>
</PageLayout>

<style>
  li {
    padding-top: 1em;
  }
  .bonny-text {
    color: #d66cd3;
  }

  .systems-text {
    color: #56d595;
  }
  .united-cleaning-text {
    color: #ebe764;
    background-color: slategray;
    padding: 0.4em;
  }
</style>
